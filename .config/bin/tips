#!/bin/bash

# NAME
#   tips - invoke tip files on demand

# SYNOPSIS
#   tips [word|word..]]
#   tips / shell_command args

# DESCRIPTION

set -o errexit -o nounset -o pipefail
shopt -s extglob nullglob globstar

[[ -n ${DEBUG-} && ${DEBUG-} != 0 ]] && set -xv

mode='tips'
if [[ ${0##*/} == @(obsidian|ob) ]]; then
  mode='obsidian'
fi

if [[ -e ~/.config/$mode/config ]]; then
  source ~/.config/$mode/config
fi

tipsdir="${tipsdir:-~/$mode}"

if [[ ! -d "$tipsdir" ]]; then
  echo "No such directory '$tipsdir', $?"
  exit 2
fi

function list_tips() {
  local pattern="${1:-.}"
  find ./* \( -name ".[!.]?*" \) \
    -prune -o -iregex ".*$pattern.*" -print0 | sort -z
}

oldpwd="$PWD"
cd "$tipsdir" || exit

if (( $# == 0 )) || [[ $1 = @(-l|--ls|--list) ]]; then
  list_tips | perl -lpe 'BEGIN{$/="\0"}' | column | less
  exit $?

elif (( $# == 0 )) || [[ $1 = @(-s|--st|--status) ]]; then
  git status --short --porcelain
  exit $?

elif (( $# == 0 )) || [[ $1 = @(--SYNC) ]]; then
  if                                                             \
    ( git diff-index HEAD -- | grep -q '.')  ||                  \
    ( git ls-files . --exclude-standard --others | grep -q '.' ) \
  ; then
    git add .
    git commit -m "Autocommit on $(hostname -f), $(date)"
  fi
  git pull && git push
  exit $?

elif [[ $1 = "/" ]]; then
  shift;
  cmd="$1"; shift;
  ( set -x; "$cmd" "$@"; ) 2>&1 | less
  exit $?;

fi

files=()
for glob in "$@"; do
  while read -r -d $'' file; do
    files+=( "$file" )
  done < <( list_tips "$glob" )
done

if (( ${#files[@]} == 0 )); then
  if (( $# == 0 )); then
    files=( . )
  else
    files=( "$@" )
  fi
fi

files=( "${files[@]//\/\///}" )
files=( "${files[@]//\*/}"    )

for f in "${files[@]}"; do
  dir="${f%%/*}";
  if [[ $dir != "$f" ]] && [[ ! -d $dir ]]; then
    mkdir -vp "$dir"
  fi
done

nvim -c 'set conceallevel=2' "${files[0]:-.}"
