#!/bin/bash

set -eu

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
cd "$SCRIPT_DIR"

repo=$(cd -- "$SCRIPT_DIR/../.." &>/dev/null && pwd)
# DRY_RUN=1 prints instead of running (nothing is downloaded, deployed or installed).
run() { if [[ ${DRY_RUN:-0} == 1 ]]; then echo "+ $*"; else "$@"; fi; }

pkgs_to_install=()

# Install keys
install-gpg-keyring() {
  [[ ${DRY_RUN:-0} == 1 ]] && { echo "+ install-gpg-keyring $*"; return 0; }
  gpg_file="$1"
  keyring_name="${2:-${1##*/}}"
	wget -qc -O- "$gpg_file" |
		gpg --dearmor |
		sudo tee /usr/share/keyrings/"$keyring_name" &>/dev/null

  gpg --no-default-keyring \
    --keyring /usr/share/keyrings/"$keyring_name" \
    --fingerprint
}

# 798A EC65 4E5C 1542 8C8E  42EE AA16 FCBC A621 E701
install-gpg-keyring 'https://apt.releases.hashicorp.com/gpg' 'hashicorp-archive-keyring.gpg'
# 2C61 0620 1985 B60E 6C7A  C873 23F3 D4EA 7571 6059
install-gpg-keyring 'https://cli.github.com/packages/githubcli-archive-keyring.gpg'

# Install packages providing our required commands
if ((${GUI:-0} == 1)); then
	type -P dmenu &>/dev/null || pkgs_to_install+=('suckless-tools')
	type -P flock &>/dev/null || pkgs_to_install+=('util-linux')
	type -P setxkbmap &>/dev/null || pkgs_to_install+=('x11-xkb-utils ')
	type -P ssh &>/dev/null || pkgs_to_install+=('openssh-client')
	type -P vim &>/dev/null || pkgs_to_install+=('vim-gtk3')
	type -P xmodmap &>/dev/null || pkgs_to_install+=('x11-xserver-utils')
	type -P xrandr &>/dev/null || pkgs_to_install+=('x11-xserver-utils')
	type -P xset &>/dev/null || pkgs_to_install+=('x11-xserver-utils')
	vi --version | grep -iq x11 || pkgs_to_install+=('vim-gtk3')

fi

# Install the packages of the selected profiles (profiles/<name>.list). Lean by default:
# base, dev and cloud. Opt in with PROFILES="base dev cloud extras"; GUI=1 adds gui.
pkgs_to_install+=($("$SCRIPT_DIR/profile-packages"))

# Keep installs lean: plain `apt install` honours APT::Install-Recommends (the existing
# APT::Get:: settings only cover apt-get), so deploy the config before installing anything.
run sudo install -D -m 0644 "$repo/root/etc/apt/apt.conf.d/default.conf" /etc/apt/apt.conf.d/default.conf

if ((${#pkgs_to_install[@]} >= 1)); then
	echo "Installing pre-requisites ... ${pkgs_to_install[*]}"
	(
		set -xv
		run sudo apt install -yqq --no-install-recommends "${pkgs_to_install[@]}"
	)
	# Mark the profile packages manual so `apt autoremove` can never reap them (a package
	# first pulled in as a dependency stays "auto" even after we list it here).
	run sudo apt-mark manual $("$SCRIPT_DIR/profile-packages")
fi
