#!/bin/bash
# Pre-commit hook that runs MANDATORY GPG validation and consistency checks
# 🚨 CRITICAL: This ENFORCES GPG signing and dotfile consistency for ALL commits
# Agents MUST fix any issues - circumventing these checks is NOT ALLOWED

# Run the MANDATORY GPG check
echo "🔐 Running MANDATORY GPG validation..."
.config/git/hooks/pre-commit-gpg-check

# Run MANDATORY consistency validation
echo "🔍 Running MANDATORY dotfile consistency validation..."
.config/git/hooks/pre-commit-consistency-check

# If we get here, both MANDATORY checks passed - proceed with commit
echo "✅ All MANDATORY pre-commit checks passed - proceeding with commit"
exit 0