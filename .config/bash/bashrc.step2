#!/bin/bash
# Step 2: Add environment setup

# Detect interactive mode
case $- in
    *i*) export INTERACTIVE_MODE=1 ;;
    *)   export INTERACTIVE_MODE=0 ;;
esac

# Simple directory resolution using BASH_SOURCE
if [[ -n "${BASH_SOURCE[0]:-}" ]]; then
    export BASHRC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
else
    export BASHRC_DIR="$HOME/.config/bash"
fi

# Derive DOTFILES_DIR
if [[ "$BASHRC_DIR" == *"/.config/dotfiles/.config/bash" ]]; then
    export DOTFILES_DIR="${BASHRC_DIR%/.config/bash}"
else
    export DOTFILES_DIR="$HOME/.config/dotfiles"
fi

# Environment setup
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Basic PATH
export PATH="$HOME/.local/bin:$HOME/.config/bin:$PATH"

echo "Step 2 bashrc loaded"
echo "BASHRC_DIR: $BASHRC_DIR"
echo "DOTFILES_DIR: $DOTFILES_DIR"
echo "INTERACTIVE_MODE: $INTERACTIVE_MODE"
echo "PATH: $PATH"