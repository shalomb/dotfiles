#!/bin/bash

# Simple bashrc - just the essentials

# ADR-001: Environment Variables Moved to bash_profile
# ====================================================
# DECISION: Remove environment variable setup from bashrc
# RATIONALE:
#   - Environment variables (PATH, MANPATH, etc.) belong in bash_profile
#   - bashrc should focus on interactive shell features (functions, aliases, options)
#   - This follows bash manpage best practices for startup file organization
# CONSEQUENCES:
#   - bashrc sources bash_profile, so environment variables are still available
#   - Cleaner separation of concerns between profile and rc files
#   - Fixes tmux new window PATH issues by ensuring proper initialization order
# ====================================================

# Set flag to prevent infinite recursion with bash_profile
export BASH_RC_SOURCED=1

# Set XDG Base Directory variables if not already set
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

# Note: PATH and other environment variables are now loaded from bash_profile
# This ensures proper initialization order for all shell types

# Load core functions and colors
if [[ -f ~/.config/bash/rc.d/01-functions ]]; then
    source ~/.config/bash/rc.d/01-functions
else
    [[ -n "$DOTFILES_DEBUG" ]] && echo "debug: Functions file missing" >&2
fi

if [[ -f ~/.config/bash/rc.d/02-colours ]]; then
    source ~/.config/bash/rc.d/02-colours
else
    [[ -n "$DOTFILES_DEBUG" ]] && echo "debug: Colors file missing" >&2
fi

# Load aliases
if [[ -f ~/.config/bash/aliases ]]; then
    source ~/.config/bash/aliases
fi

# Load completion
if [[ -f ~/.config/bash/completion ]]; then
    source ~/.config/bash/completion
fi

# Load dotfiles command
# Load essential functions (cdp, etc)

# Load bash history configuration
if [[ -f ~/.config/bash/tools/history.sh ]]; then
    source ~/.config/bash/tools/history.sh
else
    [[ -n "$DOTFILES_DEBUG" ]] && echo "debug: History tools file missing" >&2
fi

# Load AWS functions
if [[ -f ~/.config/bash/tools/aws.sh ]]; then
    source ~/.config/bash/tools/aws.sh
else
    [[ -n "$DOTFILES_DEBUG" ]] && echo "debug: AWS tools file missing" >&2
fi

# Load Git functions
# Load git-bar (gbar command)
if [[ -f ~/.config/bash/tools/git-bar.sh ]]; then
    source ~/.config/bash/tools/git-bar.sh
else
    [[ -n "$DOTFILES_DEBUG" ]] && echo "debug: Git bar tools file missing" >&2
fi

if [[ -f ~/.config/bash/tools/git.sh ]]; then
    source ~/.config/bash/tools/git.sh
else
    [[ -n "$DOTFILES_DEBUG" ]] && echo "debug: Git tools file missing" >&2
fi

if [[ -f ~/.config/bash/tools/fzf-utils.sh ]]; then
    source ~/.config/bash/tools/fzf-utils.sh
else
    [[ -n "$DOTFILES_DEBUG" ]] && echo "debug: FZF utils file missing" >&2
fi

if [[ -f ~/.config/bash/rc.d/dotfiles ]]; then
    source ~/.config/bash/rc.d/dotfiles
else
    [[ -n "$DOTFILES_DEBUG" ]] && echo "debug: Dotfiles command file missing" >&2
fi

# Set up ghostship prompt
if command -v ghostship >/dev/null 2>&1; then
    # Define the missing 'defined' function that ghostship init depends on
    defined() {
        type "$1" &>/dev/null
    }
    
    # Ensure COLUMNS is set to prevent ghostship hang
    export COLUMNS="${COLUMNS:-80}"
    
    # Try to initialize ghostship, but handle errors gracefully
    if source <(ghostship init bash) 2>/dev/null; then
        # Ghostship initialized successfully
        [[ -n "$DOTFILES_DEBUG" ]] && echo "debug: ghostship init succeeded" >&2
    else
        [[ -n "$DOTFILES_DEBUG" ]] && echo "debug: ghostship init failed, using fallback prompt" >&2
        # Simple fallback prompt
        PS1='\u@\h:\w\$ '
    fi
else
    [[ -n "$DOTFILES_DEBUG" ]] && echo "debug: ghostship not available, using fallback prompt" >&2
    # Simple fallback prompt
    PS1='\u@\h:\w\$ '
fi

# Simple reload function
reload() {
    # Source the repository version directly to avoid circular reference
    source ~/.config/dotfiles/.config/bash/bashrc
}
. "$HOME/.local/bin/env"
