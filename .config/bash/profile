#!/bin/bash

 #######################################################################
#   ~/.config/bash/profile: executed by bash(1) for login shells.       #
#     Installed at ~/.bash_profile for legacy reasons.                  #
#                                                                       #
#   See /usr/share/doc/bash/examples/startup-files for examples;        #
#     these files are located in the bash-doc package.                  #
 #######################################################################

# For SSH logins, we need to source bashrc even if not interactive initially
# Only skip if we're definitely non-interactive (like running scripts)
if [[ -z "$PS1" && -z "$SSH_CLIENT" && -z "$SSH_TTY" ]]; then
  return 0
fi

# the default umask is set in /etc/login.defs
umask 022

if [[ $TERM == 'linux' ]]; then
  setterm -blength 0
fi

# Fix TERM for clickable links support
if [[ $TERM == 'dumb' ]]; then
  export TERM=tmux-256color
fi

if [[ -r ~/.config/bash/bashrc ]]; then
  source ~/.config/bash/bashrc
fi

if [[ ${TTY:-$(tty)} == /dev/tty1 ]]; then
  unset TMOUT
  tmout 5 "exec startx > $TMP/startx.log 2>&1"
  TMOUT=120
  clear
fi
