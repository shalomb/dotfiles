#!/bin/bash
# Clean, simple bashrc - no symlink dependencies, no complex conditionals
# Works regardless of deployment method

# =============================================================================
# PHASE 0: Bootstrap
# =============================================================================

# Enable tracing if requested
[[ -n ${BASHRC_TRACE_SOURCING:-} ]] && set -xv

# Detect interactive mode
case $- in
    *i*) export INTERACTIVE_MODE=1 ;;
    *)   export INTERACTIVE_MODE=0 ;;
esac

# Simple, robust directory resolution using BASH_SOURCE
if [[ -n "${BASH_SOURCE[0]:-}" ]]; then
    export BASHRC_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
else
    export BASHRC_DIR="$HOME/.config/bash"
fi

# Derive DOTFILES_DIR from BASHRC_DIR
if [[ "$BASHRC_DIR" == *"/.config/dotfiles/.config/bash" ]]; then
    export DOTFILES_DIR="${BASHRC_DIR%/.config/bash}"
else
    export DOTFILES_DIR="$HOME/.config/dotfiles"
fi

# Validate bootstrap succeeded
if [[ ! -d "$BASHRC_DIR" ]]; then
    echo "ERROR: BASHRC_DIR not found: $BASHRC_DIR" >&2
    return 1
fi

# =============================================================================
# PHASE 1: Environment Setup
# =============================================================================

# XDG directories
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Basic PATH setup
export PATH="$HOME/.local/bin:$HOME/.config/bin:$PATH"

# =============================================================================
# PHASE 2: Core Functions
# =============================================================================

# Guard function for defensive loading
guard() {
    command -v "$1" >/dev/null 2>&1
}

# Check if command exists
has-cmd() {
    command -v "$1" >/dev/null 2>&1
}

# =============================================================================
# PHASE 3: Load Configuration
# =============================================================================

# Load lib scripts if they exist
if [[ -d "$BASHRC_DIR/lib" ]]; then
    for script in "$BASHRC_DIR"/lib/*.sh; do
        [[ -f "$script" && -r "$script" ]] && source "$script"
    done
fi

# Load enabled scripts (interactive only)
if [[ $INTERACTIVE_MODE -eq 1 && -d "$BASHRC_DIR/enabled" ]]; then
    for script in "$BASHRC_DIR"/enabled/*.sh; do
        [[ -f "$script" && -r "$script" ]] && source "$script"
    done
fi

# =============================================================================
# PHASE 4: Interactive Features
# =============================================================================

if [[ $INTERACTIVE_MODE -eq 1 ]]; then
    # Set up prompt
    PS1='\u@\h:\w\$ '
    
    # Define reload function
    reload() {
        echo "Reloading bashrc..."
        source ~/.bashrc
    }
fi

[[ -n "$BASHRC_TRACE_SOURCING" ]] && echo "[bashrc] Initialization complete" >&2