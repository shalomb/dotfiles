{
  "version": 1,
  "attribution": {
    "attributeCommitsToAgent": false,
    "attributePRsToAgent": false
  },
  "editor": {
    "vimMode": false
  },
  "network": {
    "useHttp1ForAgent": false
  },
  "permissions": {
    "allow": [
      "Shell(ls)",
      "Shell(command)",
      "Shell(echo)",
      "Shell(which)",
      "Shell(rg)",
      "Shell(head)",
      "Shell(fd)",
      "Shell(eza)",
      "Shell(jq)",
      "Shell(http)",
      "Shell(sd)",
      "Shell(sg)",
      "Shell(cd)",
      "Shell(git status)",
      "Shell(git branch)",
      "Shell(git fetch)",
      "Shell(git checkout)",
      "Shell(git pull)",
      "Shell(grep)"
    ],
    "deny": []
  },
  "approvalMode": "allowlist",
  "display": {
    "showLineNumbers": false,
    "showThinkingBlocks": true,
    "showStatusIndicators": false,
    "showStatusLineRunningTime": false,
    "mode": "zen"
  },
  "sandbox": {
    "mode": "disabled",
    "networkAccess": "user_config_with_defaults"
  },
  "exploreSubagentModel": "default",
  "autoAcceptWebSearch": false
}
