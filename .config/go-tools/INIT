#!/bin/bash

# tflint :/
curl -s https://raw.githubusercontent.com/terraform-linters/tflint/master/install_linux.sh | bash

function go-install() {
  ( set -xv
    go install -v "$@"
  );
  echo
}

go-install github.com/ankitpokhrel/jira-cli/cmd/jira@latest
go-install github.com/antonmedv/fx@latest
go-install github.com/aquasecurity/tfsec/cmd/tfsec@latest
go-install github.com/canthefason/go-watcher/cmd/watcher@latest
go-install github.com/fiatjaf/jiq/cmd/jiq@latest
go-install github.com/fullstorydev/grpcurl/cmd/grpcurl@latest
go-install github.com/go-delve/delve/cmd/dlv@latest
go-install github.com/golangci/golangci-lint/cmd/golangci-lint@latest
go-install github.com/google/yamlfmt/cmd/yamlfmt@latest
go-install github.com/jesseduffield/lazygit@latest
go-install github.com/mrtazz/checkmake/cmd/checkmake@latest
go-install github.com/muesli/duf@latest
go-install github.com/nektos/act@latest
go-install github.com/spf13/cobra-cli@latest
go-install github.com/stern/stern@latest
# aws-sso: Pin to v2.1.0 (v2.0.0+ required for 'login' command)
# NOTE: Using @latest may install v1.x which lacks the 'login' command
go-install github.com/synfinatic/aws-sso-cli/cmd/aws-sso@v2.1.0
# Verify aws-sso v2.0.0+ is installed (login command added in v2.0.0)
if ! aws-sso login --help >/dev/null 2>&1; then
  echo "ERROR: aws-sso v2.0.0+ required but 'login' command not found" >&2
  echo "Installed version may be v1.x. Please reinstall:" >&2
  echo "  go install github.com/synfinatic/aws-sso-cli/cmd/aws-sso@v2.1.0" >&2
  exit 1
fi
go-install github.com/terraform-docs/terraform-docs@latest
go-install github.com/warrensbox/terraform-switcher@latest
go-install golang.org/x/lint/golint@latest
go-install github.com/shalomb/gum@latest
go-install github.com/shalomb/ob-cli/cmd/ob-cli@latest
