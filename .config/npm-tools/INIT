#!/bin/bash

set -eu

sudo apt-get -yyq --no-install-recommends --no-install-suggests install nodejs npm

sudo npm install \
  @devcontainers/cli \
  bash-language-server \
  markdownlint-cli2 \
  mcp-hub \
  @mermaid-js/mermaid-cli \
  neovim \
  tree-sitter \
  write-good

# User-prefix install (no sudo): nvim's copilot.lua resolves it via ~/.local/bin
npm install -g --prefix "$HOME/.local" @github/copilot-language-server@latest
