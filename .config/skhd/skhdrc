# ctrl + alt + cmd - l : yabai -m window --resize left:-10:0
# ctrl + alt + cmd - h : yabai -m window --resize right:-10:0

ctrl + cmd - m : yabai -m window --minimize
ctrl + cmd - r : yabai -m space --rotate 90
alt + cmd  - r : yabai -m space --rotate 90
ctrl + cmd - s : yabai -m window --toggle split
# Toggle float and center the window - r/c
ctrl + cmd - t : yabai -m window --toggle float --grid 4:4:1:1:2:2 && \
                  yabai -m window --toggle border # mnemonic tiled
ctrl + cmd - x : yabai -m window --toggle sticky
ctrl + cmd - y : yabai -m window --toggle border

# ctrl - return : skhd -k 'cmd - space'
cmd - return : skhd -k 'alt + cmd - space'
ctrl + cmd - return : ~/.bin/yabai-launcher
alt + cmd - return : ~/.bin/yabai-launcher

ctrl + cmd - 0x27 : yabai -m window --focus recent  || \
      yabai -m display --focus recent # apostrophe
ctrl + cmd - n : yabai -m space --layout "$( \
      yabai -m query --spaces --space | \
      jq -r 'if .type == "bsp" then "stack" else "bsp" end' )"

# TODO: These don't appear to be functional
# cmd - 0x78 : skhd -k 'ctrl - 0x78' # f2 -> Apple menu
# cmd - 0x63 : skhd -k 'ctrl - 0x63' # f3 -> Dock

cmd - 0x6E : open -a 'Launchpad'

cmd - 0x69 : open ~/
ctrl + shift - escape : open -a 'Activity Monitor'

alt + rctrl - a : open /Applications
alt + rctrl - d : open ~/Downloads
alt + rctrl - e : open ~/
alt + rctrl - p : open ~/projects/
alt + rctrl - f : open -a Firefox
alt + rctrl - g : skhd -k "cmd - c" && sleep 0.2 && \
                  open 'https://www.google.com/search?q='$(pbpaste | tr ' ' +)
alt + rctrl - h : open ~/
alt + rctrl - k : open -a "Google Keep"
alt + rctrl - o : open -a "Microsoft Outlook"
alt + rctrl - s : open -a Spotify
alt + rctrl - y : ~/.bin/copy-url-markdown-link | pbcopy -
alt + rctrl - z : yabai -m window --toggle zoom-parent

cmd - 0x2C : open -a WezTerm # slash

ctrl - 0x2C [
  "Finder"              : skhd -k "cmd - f"
]

ctrl - p [
  "Finder"              : skhd -k "up"
]

ctrl - n [
  "Finder"              : skhd -k "down"
]

ctrl - i [
  "Finder"              : skhd -k "cmd - 0x1E"
]

ctrl - o [
  "Finder"              : skhd -k "cmd - 0x21"
]

ctrl - l [
  "Finder"              : skhd -k "cmd + shift - g"
]

ctrl - c [
  "firefox"              : skhd -k "cmd - c"
  "google chrome"        : skhd -k "cmd - c"
  "microsoft excel"      : skhd -k "cmd - c"
  "microsoft outlook"    : skhd -k "cmd - c"
  "microsoft powerpoint" : skhd -k "cmd - c"
  "microsoft teams"      : skhd -k "cmd - c"
  "microsoft word"       : skhd -k "cmd - c"
]

# Control+V - if outlook, paste and match style, if other office, paste special
ctrl - v [
  "firefox"              : skhd -k "cmd - v"
  "google chrome"        : skhd -k "cmd - v"
  "microsoft excel"      : skhd -k "cmd + ctrl - v"
  "microsoft outlook"    : skhd -k "alt + cmd + shift - v"
  "microsoft powerpoint" : skhd -k "cmd + ctrl - v"
  "microsoft teams"      : skhd -k "alt + cmd + shift - v"
  "microsoft word"       : skhd -k "cmd + ctrl - v"
]

ctrl - l [
  "firefox"       : skhd -k "cmd - l"
  "google chrome" : skhd -k "cmd - l"
]

ctrl - x [
  "firefox"              : skhd -k "cmd - x"
  "google chrome"        : skhd -k "cmd - x"
  "microsoft excel"      : skhd -k "cmd - x"
  "microsoft outlook"    : skhd -k "cmd - x"
  "microsoft powerpoint" : skhd -k "cmd - x"
  "microsoft teams"      : skhd -k "cmd - x"
  "microsoft word"       : skhd -k "cmd - x"
]

# mark mode
:: mark @ : yabai -m config active_window_border_color 0xFFFAC863

alt + cmd - 0x2B    ; mark # Comma
mark < escape ; default

mark < o : open /tmp/
mark < q : yabai -m window --close

