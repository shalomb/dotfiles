#!/usr/bin/env sh

# https://github.com/koekeishiya/skhd/blob/master/examples/skhdrc
# https://eastmanreference.com/complete-list-of-applescript-key-codes

# Mac Shortcuts
# ctrl + down

# default mode
:: default  : yabai -m config active_window_border_color 0xffff781f

alt + cmd - o : ~/.bin/toggle_app Outlook Calendar
alt + cmd - m : ~/.bin/toggle_app Outlook Inbox
alt + cmd - t : ~/.bin/toggle_app "Microsoft Teams"
# osascript ~/applescripts/raise_previous_app.scpt   # Apostrophe
alt + cmd - 0x27 :  skhd -k 'cmd - 0x0A' # cmd - apostrophe -> cmd - backtick
cmd - 0x27 :        skhd -k 'cmd - 0x30' # apostrophe -> tab

ctrl + cmd - b : yabai -m space --layout bsp
ctrl + cmd - f : yabai -m space --layout float
# ctrl + alt + cmd - r : yabai --restart-service
ctrl + cmd - d : ~/.bin/display-waker down && \
                sleep 1 && \
                ~/.bin/display-waker up
ctrl + cmd - e : yabai -m space --balance
ctrl + cmd - i : launchctl kickstart -k "gui/${UID}/homebrew.mxcl.yabai"  # reload yabai

alt + cmd - h : yabai -m window --focus west   || \
                yabai -m display --focus prev || yabai -m display --focus last
alt + cmd - j : yabai -m window --focus south  || \
                yabai -m space --mirror x-axis || yabai -m space --mirror y-axis
alt + cmd - k : yabai -m window --focus north  || \
                yabai -m space --mirror y-axis || yabai -m space --mirror x-axis
alt + cmd - l : yabai -m window --focus east   || \
                yabai -m display --focus prev || yabai -m display --focus last

ctrl + cmd - h : yabai -m window --swap west || \
                { winid=$(yabai -m query --windows --window | jq '.id') && \
                    yabai -m window --display recent && \
                    yabai -m window --focus "$winid"; }
ctrl + cmd - j : yabai -m window --swap south
ctrl + cmd - k : yabai -m window --swap north
ctrl + cmd - l : yabai -m window --swap east || \
                { winid=$(yabai -m query --windows --window | jq '.id') && \
                  yabai -m window --display recent && \
                  yabai -m window --focus "$winid"; }

