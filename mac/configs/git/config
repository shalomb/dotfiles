; gitconfig

; git config --local --edit

[branch]
  autosetupmerge  = always
  autosetuprebase = always

[color]
  branch       = auto
  diff         = auto
  grep         = auto
  interactive  = auto
  showbranch   = auto
  status       = auto
  ui           = auto

[color "status"]
  header    = 246 bold   # white
  added     = 42  bold   # green
  changed   = 160 bold   # red
  untracked = 75  bold   # blue

[color "branch"]
  current   = 42  bold   # green
  local     = 75  dim    # blue
  remote    = 166 dim    # green
  upstream  = 160 dim    # red

[color "diff"]
  meta      = 248 dim    # white
  frag      = 75  bold   # blue
  old       = 160 dim    # red
  new       = 42  bold   # green

[commit]
  gpgsign = true

[core]
  editor = vi
  pager = less
  pager = delta ; less -FRXK

[credential]
  helper = store --file ~/.config/git-credentials
  helper = cache --timeout 86400
	helper = osxkeychain

; https://dandavison.github.io/delta/installation.html
[delta]
  navigate = true    # use n and N to move between diff sections

  ; true-color = always
  dark = true
  ; light = true
  side-by-side = true
  ; line-numbers-left-format = ""
  ; line-numbers-right-format = "│ "

  features = side-by-side line-numbers decorations zebra-dark
  ; syntax-theme = Dracula
  syntax-theme = Monokai Extended
  plus-style = syntax "#003800"
  minus-style = syntax "#3f0001"

  map-styles = bold purple => syntax magenta, bold cyan => syntax blue

  hyperlinks = true
  hyperlinks-file-link-format = "vscode://file/{path}:{line}"
  hyperlinks-file-link-format = "my-file-line-protocol://{path}:{line}"

[delta "decorations"]
  commit-decoration-style = bold green box ul
  file-style = bold yellow ul
  file-decoration-style = none
  hunk-header-decoration-style = darkgray box ul

[delta "line-numbers"]
  ; line-numbers-left-style =  darkgray bold
  ; line-numbers-right-style = darkgray bold
  line-numbers-minus-style = 124
  line-numbers-plus-style = 28

[delta "zebra-dark"]
    minus-style = syntax "#330f0f"
    minus-emph-style = syntax "#4f1917"
    plus-style = syntax "#0e2f19"
    plus-emph-style = syntax "#174525"
    map-styles = \
       bold purple => syntax "#330f29", \
       bold blue => syntax "#271344", \
       bold cyan => syntax "#0d3531", \
       bold yellow => syntax "#222f14"
    zero-style = syntax
  whitespace-error-style = "#aaaaaa"

[diff]
  ignoreSubmodules = dirty
  tool = delta
  colorMoved = default
  pager = delta
  ; external = delta

[difftool]
  prompt = false

[difftool "difftastic"]
    # See `man git-difftool` for a description of MERGED, LOCAL and REMOTE.
    cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"

[fetch]
  prune = true

[github]
  user  = shalomb

[gpg]
   program = /opt/homebrew/bin/gpg
;   program = /usr/bin/gpg2

[help]
  autocorrect = prompt

[init]
  defaultBranch = main

[interactive]
  diffFilter = delta --color-only

[merge]
  autoStash = true
  conflictstyle = zdiff3
  tool = vimdiff

[mergetool]
  prompt = false

[pager]
  diff = true
  difftool = true
  show = true

[pull]
  rebase = true

[push]
  default = simple
  autoSetupRemote = true

[rebase]
  autoStash = true

[show]
  ; pager = delta
  difftool = true
  diff = true

[tag]
  sort = version:refname

[user]
  name = Shalom Bhooshi
  email = s.bhooshi@gmail.com
	signingKey = 7161BD4E07DCC2AAC45F06BFB6C98401B6100A2D

[alias]
  ammend  = commit --amend -C HEAD
  base    = !echo ${BASE:-$(git rev-parse --abbrev-ref HEAD)}
  br      = branch
  caa     = commit -a --amend -C HEAD
  ce      = config --global -e
  ci      = commit
  co      = checkout
  dc      = diff --cached
  df      = diff
  ec      = config -e
  exec    = "!exec "
  files   = !git diff --name-only $(git merge-base HEAD \"$(git base)\")
  ign     = ls-files -o -i --exclude-standard
  k       = !gitk
  lg      = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  lgp     = log -p
  lola    = log --graph --decorate --pretty=oneline --abbrev-commit --all
  lol     = log --graph --decorate --pretty=oneline --abbrev-commit
  ls      = ls-files
  n       = !git --no-pager
  pom     = push origin master
  pum     = pull origin master
  review  = !vi -p $(git files) +\"tabdo Gvdiff $(git base)\" +\"let g:gitgutter_diff_base = '$(git base)'\"
  rm-merged = !git branch --format '%(refname:short) %(upstream:track)' | awk '$2 == \"[gone]\" { print $1 }' | xargs -r git branch -D
  s       = status --porcelain
  stat    = !git diff --stat $(git merge-base HEAD \"$(git base)\")
  st      = status --short
  today   = log --since "yesterday"
  tree    = log --graph --oneline --decorate
  undo    = reset HEAD~1 --mixed
  up      = !git fetch --all && git pull --rebase --prune $@ && git rm-merged && git submodule update --init --recursive
  vimdiff = difftool -y -t vimdiff
  wow     = log --graph --decorate --pretty=oneline --abbrev-commit --name-status
	add-and-show = !git add . && git status --short

