# SSH Configuration Template
# ==========================
# This file contains SSH client configuration that can be safely version controlled.
# Private keys and sensitive data are excluded via .gitignore

# Global settings
Host *
    # Security settings
    ServerAliveInterval 60
    ServerAliveCountMax 3
    TCPKeepAlive yes

    # Connection settings
    ControlMaster auto
    ControlPath ~/.ssh/control-%r@%h:%p
    ControlPersist 10m

    # Compression
    Compression yes

    # Key settings (uncomment and customize as needed)
    # IdentityFile ~/.ssh/id_rsa
    # IdentityFile ~/.ssh/id_ed25519

    # Forwarding (uncomment as needed)
    # ForwardAgent yes
    # ForwardX11 yes
    # ForwardX11Trusted yes

Host host
  Hostname 10.211.55.2
  User egn8687

Host mac
  Hostname 10.211.55.2
  User egn8687

