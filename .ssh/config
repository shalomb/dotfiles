# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

Host idun
  HostName <INTERNAL_IP_1>
  user <USERNAME_1>

Host debas
  HostName <INTERNAL_IP_2>
  user <USERNAME_1>

Host host
  HostName <INTERNAL_IP_3>
  user <USERNAME_2>

Host *
  AddKeysToAgent yes
# UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
  CheckHostIP        no
  Compression        yes
  ConnectionAttempts 3
  ConnectTimeout     5
  ControlMaster      auto
  ControlPath        ~/.ssh/master-%r@%h:%p
  ControlPersist     600
  ForwardAgent       no
  ForwardX11         no
  ForwardX11Trusted  no
  GSSAPIAuthentication no
# GSSAPITrustDns     no
  HashKnownHosts     no
  HostbasedAuthentication no
  IdentitiesOnly     no
  IPQoS              lowdelay
  PasswordAuthentication no
  PubkeyAuthentication yes     # << Set to yes unless you have a specific reason
  # TCPKeepAlive       yes
  UpdateHostKeys     ask
  ServerAliveInterval 15
  StrictHostKeyChecking yes
  VisualHostKey      yes