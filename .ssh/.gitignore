# SSH Security - NEVER commit these files
# =====================================

# Private keys - CRITICAL SECURITY
id_*
*_rsa
*_dsa
*_ecdsa
*_ed25519
*_rsa_*
*_dsa_*
*_ecdsa_*
*_ed25519_*

# Private key formats
*.pem
*.key
*.p12
*.pfx

# SSH agent sockets and runtime data
agent-*
auth_sock*

# Backup and temporary files
*.bak
*.tmp
*.old
*~

# SSH control sockets
control-*

# But allow our config files and public keys
!config
!known_hosts
!*.pub
!authorized_keys
!authorized_keys2
