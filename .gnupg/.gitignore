# GPG Security - NEVER commit these files
# ======================================

# Private key material - CRITICAL SECURITY
private-keys-v1.d/
secring.gpg
*.gpg~
*.kbx~

# Trust and revocation data
trustdb.gpg
gpg-revocation-certificate
openpgp-revocs.d/

# SSH integration
sshcontrol
S.gpg-agent.ssh

# Agent sockets and runtime data
S.gpg-agent*
random_seed
tofu.db

# Backup and temporary files
backup/
.#lk*
lookup.md
Makefile
otrust.lst
ownertrust.txt

# Public keyring (optional - can be shared but often large)
pubring.kbx
pubring.gpg

# Any other sensitive files
*.key
*.asc
*.gpg
*.sig

# But allow our config files
!gpg.conf
!gpg-agent.conf
!dirmngr.conf
