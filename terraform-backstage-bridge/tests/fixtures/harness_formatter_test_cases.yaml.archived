# ARCHIVED: Harness formatter test cases (merged into parser_test_cases.yaml)
# This file was archived during fixture consolidation as the test cases
# are now covered by comprehensive harness_expected_result fields in parser_test_cases.yaml

# Test cases for Harness formatter validation
harness_formatter_test_cases:
- name: basic_primitives
  description: Test basic primitive types (string, number, bool)
  terraform_variables:
  - name: environment
    type: string
    description: Environment name
    default: dev
  - name: instance_count
    type: number
    description: Number of instances
    default: 2
  - name: enable_monitoring
    type: bool
    description: Enable monitoring
    default: true
  expected_harness_properties:
    environment:
      title: Environment name
      description: Environment name
      type: string
      default: dev
      enum:
      - dev
      - staging
      - prod
      ui:widget: select
    instance_count:
      title: Number of instances
      description: Number of instances
      type: number
      default: 2
    enable_monitoring:
      title: Enable monitoring
      description: Enable monitoring
      type: boolean
      default: true
      ui:widget: radio
      ui:options:
        inline: true
- name: complex_object_types
  description: Test complex object types with nested properties
  terraform_variables:
  - name: server_config
    type: object({"instance_type":"string","ami_id":"string","disk_size":"number","monitoring":"bool"})
    description: Server configuration object
    default:
      instance_type: t3.micro
      ami_id: ami-12345
      disk_size: 20
      monitoring: false
  expected_harness_properties:
    server_config:
      title: Server configuration object
      description: Server configuration object
      type: object
      default:
        instance_type: t3.micro
        ami_id: ami-12345
        disk_size: 20
        monitoring: false
      properties:
        instance_type:
          title: Instance Type
          type: string
        ami_id:
          title: Ami Id
          type: string
        disk_size:
          title: Disk Size
          type: number
        monitoring:
          title: Monitoring
          type: boolean
          ui:widget: radio
          ui:options:
            inline: true
- name: validation_constraints
  description: Test validation constraints from real building blocks
  terraform_variables:
  - name: os
    type: string
    description: "The OS for the EC2(s). One of: `RHEL9`, `RHEL8`, `RHEL7`, `Windows2019`, `Windows2016`,\
      \ `AZL2`"
    default: RHEL8
    validation:
    - condition: "contains([\"RHEL9\", \"RHEL8\", \"RHEL7\", \"Windows2019\", \"Windows2016\", \"AZL2\"\
        ], var.os)"
      error_message: Not a valid operating system!
  - name: instance_tier
    type: string
    description: "The network tier in which the instance will be deployed. One of: `app`, `dat`, `web`"
    default: app
    validation:
    - condition: contains(["web", "app", "dat"], var.instance_tier)
      error_message: Not a valid instance tier!
  expected_harness_properties:
    os:
      title: "The OS for the EC2(s). One of: `RHEL9`, `RHEL8`, `RHEL7`, `Windows2019`, `Windows2016`,\
        \ `AZL2`"
      description: "The OS for the EC2(s). One of: `RHEL9`, `RHEL8`, `RHEL7`, `Windows2019`, `Windows2016`,\
        \ `AZL2`"
      type: string
      default: RHEL8
      enum:
      - RHEL9
      - RHEL8
      - RHEL7
      - Windows2019
      - Windows2016
      - AZL2
      ui:widget: select
    instance_tier:
      title: "The network tier in which the instance will be deployed. One of: `app`, `dat`, `web`"
      description: "The network tier in which the instance will be deployed. One of: `app`, `dat`, `web`"
      type: string
      default: app
      enum:
      - web
      - app
      - dat
      ui:widget: select
