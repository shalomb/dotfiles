FROM debian:latest

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    bash \
    git \
    jq \
    ripgrep \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install cursor-agent
RUN curl https://cursor.com/install -fsS | bash

# Add cursor-agent to PATH
ENV PATH="/root/.local/share/cursor-agent/versions/2025.09.18-7ae6800:$PATH"

# Verify cursor-agent installation
RUN cursor-agent --version

# Create directories for custom tools
RUN mkdir -p /usr/local/bin /config

# Copy custom tools from dotfiles (will be mounted at runtime)
# This allows for dynamic tool updates without rebuilding the image

# Set working directory
WORKDIR /workspace

# Default entrypoint
ENTRYPOINT ["/bin/bash"]
