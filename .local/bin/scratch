#!/usr/bin/env python3
"""scratch - shadow scratch notes kept outside the git tree (ADR-014).

usage: scratch [name]        open note in $EDITOR (default name: notes)
       scratch list          list notes of this worktree, plus orphans
       scratch path [name]   print the note path
       scratch promote [name] [--to-doc [--purpose P]] [--to-obsidian] [--title T]
                             copy a note into <repo>/docs/<purpose>/ (default) and/or
                             the Obsidian vault; prints each destination path

store: ${SCRATCH_ROOT:-~/.cache/agent-skills/scratch}/<repo-slug>/<worktree>/<name>.md
"""

import argparse
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

DEFAULT_NAME = "notes"
PURPOSES = {
    "tutorials": "tutorials",
    "tutorial": "tutorials",
    "how-to": "how-to",
    "howto": "how-to",
    "reference": "reference",
    "explanation": "explanation",
}
DEFAULT_PURPOSE = "explanation"


def git(*args):
    result = subprocess.run(
        ["git", *args], capture_output=True, text=True, check=False
    )
    return result.stdout.strip() if result.returncode == 0 else None


def store_root() -> Path:
    root = os.environ.get("SCRATCH_ROOT")
    if root:
        return Path(root)
    return Path.home() / ".cache" / "agent-skills" / "scratch"


def repo_slug() -> str:
    url = git("config", "--get", "remote.origin.url")
    if url:
        base = re.split(r"[/:]", url.rstrip("/"))[-1]
        base = base.removesuffix(".git")
        if base:
            return base
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if common is None:
        die("not inside a git repository")
    common_path = Path(common)
    if common_path.name == ".git":
        return common_path.parent.name
    return common_path.name.removesuffix(".git")


def worktree_name() -> str:
    top = git("rev-parse", "--show-toplevel")
    if top is None:
        die("not inside a git repository")
    return Path(top).name


def live_worktree_names() -> set:
    out = git("worktree", "list", "--porcelain") or ""
    return {
        Path(line.split(" ", 1)[1]).name
        for line in out.splitlines()
        if line.startswith("worktree ")
    }


def note_path(name: str) -> Path:
    if "/" in name or name.startswith("."):
        die(f"invalid note name: {name}")
    slug = repo_slug()
    return store_root() / slug / worktree_name() / f"{name}.md"


def die(message: str):
    print(f"scratch: {message}", file=sys.stderr)
    sys.exit(1)


def cmd_path(name: str) -> int:
    print(note_path(name))
    return 0


def cmd_list() -> int:
    slug_dir = store_root() / repo_slug()
    current = worktree_name()
    live = live_worktree_names()
    for note in sorted((slug_dir / current).glob("*.md")):
        print(note.stem)
    if slug_dir.is_dir():
        for wt_dir in sorted(p for p in slug_dir.iterdir() if p.is_dir()):
            if wt_dir.name == current or wt_dir.name in live:
                continue
            for note in sorted(wt_dir.glob("*.md")):
                print(f"{note.stem}\torphan\t{wt_dir.name}\t{note}")
    return 0


def cmd_open(name: str) -> int:
    path = note_path(name)
    path.parent.mkdir(parents=True, exist_ok=True)
    os.close(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644))
    editor = shlex.split(os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi")
    return subprocess.run([*editor, str(path)], check=False).returncode


HEADING = re.compile(r"^# +(.+?)\s*#*\s*$")


def extract_title(text: str, name: str) -> str:
    in_fence = False
    for line in text.splitlines():
        if line.startswith(("```", "~~~")):
            in_fence = not in_fence
        elif not in_fence and (m := HEADING.match(line)):
            return m.group(1)
    return name.replace("-", " ").replace("_", " ").strip().title() or name


def slugify(title: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-") or "note"


def with_title(text: str, title: str) -> str:
    """Return text whose first H1 is `title` (prepend one if missing)."""
    lines = text.splitlines(keepends=True)
    in_fence = False
    for i, line in enumerate(lines):
        if line.startswith(("```", "~~~")):
            in_fence = not in_fence
        elif not in_fence and HEADING.match(line):
            lines[i] = f"# {title}\n"
            return "".join(lines)
    return f"# {title}\n\n{text}"


def write_new(dest: Path, content: str):
    dest.parent.mkdir(parents=True, exist_ok=True)
    try:
        with open(dest, "x", encoding="utf-8") as fh:
            fh.write(content)
    except FileExistsError:
        die(f"destination exists, not overwriting: {dest}")


def cmd_promote(argv) -> int:
    ap = argparse.ArgumentParser(
        prog="scratch promote",
        description="Promote a scratch note (copy; the source note is kept).",
    )
    ap.add_argument("name", nargs="?", default=DEFAULT_NAME)
    ap.add_argument("--to-doc", action="store_true",
                    help="copy to <repo>/docs/<purpose>/<title-slug>.md (default)")
    ap.add_argument("--purpose", choices=sorted(PURPOSES),
                    help=f"Diataxis section for --to-doc (default {DEFAULT_PURPOSE})")
    ap.add_argument("--to-obsidian", action="store_true",
                    help="copy to $OBSIDIAN_VAULT (default ~/obsidian)/scratch/<repo>/")
    ap.add_argument("--title", help="title (default: first '# ' heading, else note name)")
    args = ap.parse_args(argv)
    if args.purpose and args.to_obsidian and not args.to_doc:
        die("--purpose only applies to --to-doc")
    to_doc = args.to_doc or not args.to_obsidian
    src = note_path(args.name)
    if not src.is_file():
        die(f"no such note: {args.name} ({src})")
    text = src.read_text(encoding="utf-8")
    title = args.title or extract_title(text, args.name)
    content = with_title(text, title)
    fname = f"{slugify(title)}.md"
    dests = []
    if to_doc:
        top = git("rev-parse", "--show-toplevel")
        if top is None:
            die("not inside a git repository")
        purpose = PURPOSES[args.purpose or DEFAULT_PURPOSE]
        dests.append(Path(top) / "docs" / purpose / fname)
    if args.to_obsidian:
        vault = Path(os.environ.get("OBSIDIAN_VAULT") or Path.home() / "obsidian")
        if not vault.is_dir():
            die(f"obsidian vault not found: {vault}")
        dests.append(vault / "scratch" / repo_slug() / fname)
    for dest in dests:
        if dest.exists():
            die(f"destination exists, not overwriting: {dest}")
    for dest in dests:
        write_new(dest, content)
        print(dest)
    return 0


def main(argv) -> int:
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if argv[:1] == ["list"]:
        return cmd_list()
    if argv[:1] == ["promote"]:
        return cmd_promote(argv[1:])
    if argv[:1] == ["path"]:
        return cmd_path(argv[1] if len(argv) > 1 else DEFAULT_NAME)
    if len(argv) > 1:
        die("too many arguments")
    return cmd_open(argv[0] if argv else DEFAULT_NAME)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
