#!/bin/bash
# GPG Wait for Unlock Script
# Waits for GPG agent to be unlocked by user in another terminal

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
SIGNING_KEY="${1:-$(git config --get user.signingkey 2>/dev/null || echo '')}"
MAX_WAIT="${2:-300}"  # 5 minutes default
CHECK_INTERVAL=5

# Function to test GPG signing
test_gpg_signing() {
    local key_id="${1:-}"
    if [[ -n "$key_id" ]]; then
        echo 'test' | gpg --clearsign --default-key "$key_id" --batch --yes >/dev/null 2>&1
    else
        echo 'test' | gpg --clearsign --batch --yes >/dev/null 2>&1
    fi
}

# Function to wait for GPG unlock
wait_for_unlock() {
    local key_id="${1:-}"
    local max_wait="${2:-300}"
    local check_interval="${3:-5}"
    
    echo -e "${BLUE}🔐 Waiting for GPG agent to be unlocked...${NC}"
    echo -e "${YELLOW}Please unlock your GPG agent in another terminal${NC}"
    echo -e "${YELLOW}You can run: gpg --sign --default-key ${key_id:-'<your-key>'} < /dev/null${NC}"
    echo ""
    
    local waited=0
    while [[ $waited -lt $max_wait ]]; do
        if test_gpg_signing "$key_id"; then
            echo -e "${GREEN}✅ GPG agent is now unlocked!${NC}"
            return 0
        fi
        
        echo -e "${BLUE}⏳ Still waiting... (${waited}s/${max_wait}s)${NC}"
        sleep "$check_interval"
        waited=$((waited + check_interval))
    done
    
    echo -e "${RED}❌ Timeout waiting for GPG unlock${NC}"
    return 1
}

# Main function
main() {
    if [[ $# -gt 0 && "$1" == "--help" ]]; then
        echo "Usage: $0 [KEY_ID] [MAX_WAIT_SECONDS]"
        echo "Wait for GPG agent to be unlocked by user"
        echo ""
        echo "Arguments:"
        echo "  KEY_ID           Specific GPG key ID to test (optional)"
        echo "  MAX_WAIT_SECONDS Maximum time to wait in seconds (default: 300)"
        echo ""
        echo "Example:"
        echo "  $0 38495CCA2D2EF563 600  # Wait up to 10 minutes for specific key"
        echo ""
        exit 0
    fi
    
    local key_id="${1:-}"
    local max_wait="${2:-300}"
    
    echo -e "${BLUE}🔐 GPG Wait for Unlock${NC}"
    echo -e "Key ID: ${key_id:-'default'}"
    echo -e "Max wait: ${max_wait}s"
    echo ""
    
    # Check if GPG agent is running
    if ! gpg-connect-agent 'keyinfo --list' /bye >/dev/null 2>&1; then
        echo -e "${RED}❌ GPG agent is not running${NC}"
        exit 1
    fi
    
    # Test if already unlocked
    if test_gpg_signing "$key_id"; then
        echo -e "${GREEN}✅ GPG is already unlocked!${NC}"
        exit 0
    fi
    
    # Wait for unlock
    if wait_for_unlock "$key_id" "$max_wait" "$CHECK_INTERVAL"; then
        echo -e "${GREEN}🎉 GPG unlock successful! Cursor-agent can now sign commits.${NC}"
        exit 0
    else
        echo -e "${RED}❌ GPG unlock failed or timed out${NC}"
        exit 1
    fi
}

# Run main function
main "$@"