#!/bin/bash

# Tmux wrapper with strace debugging
# This script wraps the real tmux binary with strace to capture system calls
# when tmux crashes, helping us debug the root cause.

set -euo pipefail

# Configuration
STRACE_DIR="/tmp/tmux-strace"
REAL_TMUX="/usr/bin/tmux"
TIMESTAMP=$(date +%Y%m%d-%H%M%S-%N)
STRACE_LOG="${STRACE_DIR}/tmux-strace-${TIMESTAMP}.log"
STRACE_ERR="${STRACE_DIR}/tmux-strace-${TIMESTAMP}.err"

# Ensure strace directory exists
mkdir -p "$STRACE_DIR"

# Function to log with timestamp
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "${STRACE_DIR}/tmux-wrapper.log"
}

# Function to cleanup on exit
cleanup() {
    local exit_code=$?
    log "tmux wrapper exiting with code: $exit_code"
    if [[ $exit_code -ne 0 ]]; then
        log "tmux crashed! Check strace logs: $STRACE_LOG"
        log "Error log: $STRACE_ERR"
    fi
    exit $exit_code
}

# Set up cleanup trap
trap cleanup EXIT

# Log the start of execution
log "Starting tmux wrapper with args: $*"
log "Real tmux binary: $REAL_TMUX"
log "Strace log: $STRACE_LOG"

# Check if real tmux exists
if [[ ! -x "$REAL_TMUX" ]]; then
    log "ERROR: Real tmux binary not found at $REAL_TMUX"
    exit 1
fi

# Check if strace is available
if ! command -v strace >/dev/null 2>&1; then
    log "ERROR: strace not found, falling back to direct tmux call"
    exec "$REAL_TMUX" "$@"
fi

# Create a unique session identifier for this run
SESSION_ID="tmux-$$-${TIMESTAMP}"
log "Session ID: $SESSION_ID"

# Run tmux under strace with comprehensive tracing
log "Executing: strace -f -e trace=all -o '$STRACE_LOG' -s 1000 '$REAL_TMUX' '$@'"

# Execute with strace
strace -f \
    -e trace=all \
    -o "$STRACE_LOG" \
    -s 1000 \
    -y \
    -yy \
    -v \
    -x \
    -xx \
    "$REAL_TMUX" "$@" 2>"$STRACE_ERR"

# Capture the exit code
exit_code=$?

# Log the result
if [[ $exit_code -eq 0 ]]; then
    log "tmux completed successfully"
else
    log "tmux exited with code: $exit_code"
    log "Check strace log for details: $STRACE_LOG"
    log "Check error log: $STRACE_ERR"
    
    # Show last few lines of strace log for immediate debugging
    if [[ -f "$STRACE_LOG" ]]; then
        log "Last 10 lines of strace log:"
        tail -10 "$STRACE_LOG" >> "${STRACE_DIR}/tmux-wrapper.log"
    fi
    
    if [[ -f "$STRACE_ERR" ]]; then
        log "Error output:"
        cat "$STRACE_ERR" >> "${STRACE_DIR}/tmux-wrapper.log"
    fi
fi

exit $exit_code