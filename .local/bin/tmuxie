#!/bin/bash

# SYNOPSIS
#   tmuxie - tmux session helper with enhanced fzf integration

set -eu

shopt -s nocasematch

# Lightweight observability
# Enable by setting TMUXIE_DEBUG=1 or TMUXIE_OBS=1, optionally TMUXIE_LOG to a file path
_tmuxie_log() {
  if [[ -z "${TMUXIE_DEBUG:-}" && -z "${TMUXIE_OBS:-}" && -z "${TMUXIE_LOG:-}" ]]; then
    return 0
  fi
  local log_path
  if [[ -n "${TMUXIE_LOG:-}" ]]; then
    log_path="$TMUXIE_LOG"
  else
    # Default to XDG cache; user can override to repo ./tmp/tmuxie.log via TMUXIE_LOG
    log_path="${XDG_CACHE_HOME:-$HOME/.cache}/tmuxie/tmuxie.log"
  fi
  mkdir -p "$(dirname "$log_path")" 2>/dev/null || true
  # shellcheck disable=SC2129
  printf '%s | %s\n' "$(date +'%F %T')" "$*" >>"$log_path"
}

# Ensure PATH is properly set for popup environment
if [[ -f ~/.config/bash/rc.d/00-path ]]; then
    source ~/.config/bash/rc.d/00-path
fi

if ! type -P tmux &> /dev/null; then
  echo "tmux not installed (in \$PATH)?" >&2
  exit 2
fi

# Enhanced README preview for fzf using glow for Markdown and bat for others
function get_preview_command() {
  local bat_cmd="$HOME/.cargo/bin/bat"
  local glow_cmd="$HOME/.local/share/go/bin/glow"
  echo "if [[ -f {}/README.md ]]; then $glow_cmd --style=dark --width=50 {}/README.md; elif [[ -f {}/README.rst ]]; then $bat_cmd --color always --style=plain --line-range=1:20 {}/README.rst; elif [[ -f {}/README.txt ]]; then $bat_cmd --color always --style=plain --line-range=1:20 {}/README.txt; else echo 'No README found'; fi"
}

function in-tmux() {
  if [[ -n ${TMUX-} ]]; then
    return 0
  else
    return 1
  fi
}

function tmux-attach() {
  local session="$1"
  if in-tmux; then
    tmux switch-client -t "$session"
  else
    # In SSH contexts, don't use exec so the session stays open
    if [[ -n "${SSH_CLIENT:-}" || -n "${SSH_TTY:-}" ]]; then
      tmux attach-session -t "$session"
    else
      # Local context: use exec
      exec tmux attach-session -t "$session"
    fi
  fi
}

function sessionize() {
  local session="$1"
  local dir="${session%[ 	]*}"
  dir=$(eval echo "$dir")  # Expand tilde
  local name=${dir##*/}
  
  if command tmux has-session -t "$name" 2>/dev/null; then
    tmux-attach "$name"
  else
    if in-tmux; then
      tmux new-session -d -s "$name" -c "$dir" "bash -l" \; \
        switch-client -t "$name"
    else
      # In SSH contexts, create detached and try to attach
      if [[ -n "${SSH_CLIENT:-}" || -n "${SSH_TTY:-}" ]]; then
        tmux new-session -d -s "$name" -c "$dir" "bash -l"
        if ! tmux attach-session -t "$name" 2>/dev/null; then
          echo "Session '$name' created. Use 'tmux attach -t $name' to connect."
        fi
      else
        # Local context: create and attach with exec
        exec tmux -u -2 new-session -s "$name" -c "$dir" "bash -l"
      fi
    fi
  fi
}

function select_projects() {
  local preview_cmd
  
  preview_cmd=$(get_preview_command)
  _tmuxie_log "select_projects: term=${TERM-} lines=$(tput lines 2>/dev/null || echo ?) cols=$(tput cols 2>/dev/null || echo ?) projects=$(gum projects --format simple | wc -l)"
  
  # Get projects and pipe to fzf with README preview
  gum projects --format simple | sed 's|~/||' | \
    fzf \
      --height=100% \
      --min-height=20 \
      --no-header \
      --border \
      --reverse \
      --prompt="Select project: " \
      --preview="$preview_cmd" \
      --preview-window=hidden,right:50%:wrap \
      --bind="ctrl-/:toggle-preview"
}

function select_sessions() {
  tmux ls | \
    fzf \
      --height=100% \
      --border \
      --reverse \
      --prompt="Select session: " \
      --preview="tmux capture-pane -t {1} -p" \
      --preview-window=right:50%:wrap \
      --bind="ctrl-/:toggle-preview"
}

# Main command handling
case "${1-}" in
  -l|--list)
    _tmuxie_log "mode=list"
    session=$(select_sessions)
    session=${session%%:*}
    echo "$session"
    tmux-attach "$session"
    exit $?
    ;;
  -s|--select)
    shift
    _tmuxie_log "mode=select"
    session=$(select_projects)
    sessionize "$session"
    exit $?
    ;;
  -i|--interactive)
    _tmuxie_log "mode=interactive"
    echo -e 'sessions\nprojects' | \
      fzf \
        --height=30% \
        --border \
        --reverse \
        --prompt="Select type: " | \
      xargs -I {} sh -c 'case {} in 
        sessions) tmuxie -l ;; 
        projects) tmuxie -s ;; 
      esac'
    exit $?
    ;;
  -h|--help)
    cat << EOF
tmuxie - tmux session helper with enhanced fzf integration

USAGE:
  tmuxie [OPTIONS] [SESSION_NAME]

OPTIONS:
  -l, --list       List and select from existing tmux sessions
  -s, --select     Select from projects (using gum projects + fzf)
  -i, --interactive Interactive mode (choose sessions or projects)
  -h, --help       Show this help

PREVIEW MODES (for -s):
  README (default) - Show README.md content
  GIT              - Show git status
  STATS            - Show directory statistics
  
  Press Ctrl+T in fzf to cycle through preview modes

EXAMPLES:
  tmuxie -s                    # Select project with fzf
  tmuxie -l                    # Select existing session
  tmuxie -i                    # Interactive mode
  tmuxie my-project            # Create/switch to session named "my-project"

ENVIRONMENT:
  TMUXIE_PREVIEW_MODE          Set default preview mode (readme|git|stats)
EOF
    exit 0
    ;;
  "")
    # No arguments - interactive mode
    tmuxie -i
    exit $?
    ;;
  *)
    # Session name provided
    session_name="$1"
    ;;
esac

# Handle session name
if [[ -n "${session_name:-}" ]]; then
  # Check if session already exists first
  if command tmux has-session -t "$session_name" 2>/dev/null; then
    tmux-attach "$session_name"
  # Check if it's a project name
  elif gum projects --format simple | grep -q "^${session_name}$"; then
    # It's a project name, use it directly
    sessionize "$session_name"
  else
    # It's a session name, create session in current directory
    current_dir=$(pwd)
    session_dir="${current_dir}/${session_name}"
    if [[ -d "$session_dir" ]]; then
      sessionize "$session_dir"
    else
      # Create session in current directory with the given name
      tmux new-session -d -s "$session_name" -c "$current_dir" "bash -l"
      # Attach to the newly created session
      exec tmux attach-session -t "$session_name"
    fi
  fi
fi