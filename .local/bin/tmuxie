#!/bin/bash

# SYNOPSIS
#   tmuxie - tmux session helper with enhanced fzf integration

set -eu

shopt -s nocasematch

# Observability setup
TMUXIE_LOG="${TMUXIE_LOG:-/tmp/tmuxie-debug.log}"
mkdir -p "$(dirname "$TMUXIE_LOG")" 2>/dev/null || true

_tmuxie_log() {
  local message="$1"
  local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
  echo "[$timestamp] tmuxie: $message" >> "$TMUXIE_LOG"
  echo "[$timestamp] tmuxie: $message" >&2
}

_tmuxie_log "=== tmuxie started with args: $* ==="

# Ensure PATH is properly set for popup environment
if [[ -f ~/.config/bash/rc.d/00-path ]]; then
    source ~/.config/bash/rc.d/00-path
fi

if ! type -P tmux &> /dev/null; then
  echo "tmux not installed (in \$PATH)?" >&2
  exit 2
fi

# Simple README preview for fzf
function get_preview_command() {
  echo "if [[ -f {}/README.md ]]; then head -20 {}/README.md; elif [[ -f {}/README.rst ]]; then head -20 {}/README.rst; elif [[ -f {}/README.txt ]]; then head -20 {}/README.txt; else echo 'No README found'; fi"
}

function in-tmux() {
  if [[ -n ${TMUX-} ]]; then
    return 0
  else
    return 1
  fi
}

function tmux-attach() {
  local session="$1"
  _tmuxie_log "tmux-attach: session='$session', in-tmux=$(in-tmux && echo 'true' || echo 'false')"
  
  if in-tmux; then
    _tmuxie_log "tmux-attach: using switch-client to switch to '$session'"
    # Use switch-client to switch the parent tmux session
    tmux switch-client -t "$session"
    _tmuxie_log "tmux-attach: switched parent session to '$session'"
  else
    _tmuxie_log "tmux-attach: calling attach-session to '$session'"
    # Attach to the session (works in SSH contexts)
    exec tmux attach-session -t "$session"
  fi
}

function sessionize() {
  local session="$1"
  _tmuxie_log "sessionize: called with session='$session'"
  
  local dir="${session%[ 	]*}"
  dir=$(eval echo "$dir")  # Expand tilde
  local name=${dir##*/}
  _tmuxie_log "sessionize: parsed dir='$dir', name='$name'"
  
  if command tmux has-session -t "$name" 2>/dev/null; then
    _tmuxie_log "sessionize: session '$name' exists, attaching"
    tmux-attach "$name"
  else
    _tmuxie_log "sessionize: session '$name' does not exist, creating"
    if in-tmux; then
      _tmuxie_log "sessionize: in-tmux=true, creating detached session and switching"
      tmux new-session -d -s "$name" -c "$dir" "bash -l" \; \
        switch-client -t "$name"
      _tmuxie_log "sessionize: new-session + switch-client commands completed"
    else
      _tmuxie_log "sessionize: not in-tmux, exec-ing new session"
      exec tmux -u -l -2 new-session -s "$name" -c "$dir"
    fi
  fi
  _tmuxie_log "sessionize: function completed"
}

function select_projects() {
  local preview_cmd
  
  preview_cmd=$(get_preview_command)
  
  # Get projects and pipe to fzf with README preview
  gum projects --format simple | sed 's|~/||' | \
    fzf \
      --height=70% \
      --border \
      --reverse \
      --prompt="Select project (README): " \
      --preview="$preview_cmd" \
      --preview-window=right:50%:wrap \
      --bind="ctrl-/:toggle-preview" \
      --header="README preview - Press Ctrl+/ to toggle"
}

function select_sessions() {
  tmux ls | \
    fzf \
      --height=70% \
      --border \
      --reverse \
      --prompt="Select session: " \
      --preview="tmux capture-pane -t {1} -p" \
      --preview-window=right:50%:wrap \
      --bind="ctrl-/:toggle-preview"
}

# Main command handling
case "${1-}" in
  -l|--list)
    session=$(select_sessions)
    session=${session%%:*}
    echo "$session"
    tmux-attach "$session"
    exit $?
    ;;
  -s|--select)
    shift
    session=$(select_projects)
    sessionize "$session"
    exit $?
    ;;
  -i|--interactive)
    echo -e 'sessions\nprojects' | \
      fzf \
        --height=30% \
        --border \
        --reverse \
        --prompt="Select type: " | \
      xargs -I {} sh -c 'case {} in 
        sessions) tmuxie -l ;; 
        projects) tmuxie -s ;; 
      esac'
    exit $?
    ;;
  -h|--help)
    cat << EOF
tmuxie - tmux session helper with enhanced fzf integration

USAGE:
  tmuxie [OPTIONS] [SESSION_NAME]

OPTIONS:
  -l, --list       List and select from existing tmux sessions
  -s, --select     Select from projects (using gum projects + fzf)
  -i, --interactive Interactive mode (choose sessions or projects)
  -h, --help       Show this help

PREVIEW MODES (for -s):
  README (default) - Show README.md content
  GIT              - Show git status
  STATS            - Show directory statistics
  
  Press Ctrl+T in fzf to cycle through preview modes

EXAMPLES:
  tmuxie -s                    # Select project with fzf
  tmuxie -l                    # Select existing session
  tmuxie -i                    # Interactive mode
  tmuxie my-project            # Create/switch to session named "my-project"

ENVIRONMENT:
  TMUXIE_PREVIEW_MODE          Set default preview mode (readme|git|stats)
EOF
    exit 0
    ;;
  "")
    # No arguments - interactive mode
    tmuxie -i
    exit $?
    ;;
  *)
    # Session name provided
    session_name="$1"
    ;;
esac

# Handle session name
if [[ -n "${session_name:-}" ]]; then
  # Check if session already exists first
  if command tmux has-session -t "$session_name" 2>/dev/null; then
    tmux-attach "$session_name"
  # Check if it's a project name
  elif gum projects --format simple | grep -q "^${session_name}$"; then
    # It's a project name, use it directly
    sessionize "$session_name"
  else
    # It's a session name, create session in current directory
    current_dir=$(pwd)
    session_dir="${current_dir}/${session_name}"
    if [[ -d "$session_dir" ]]; then
      sessionize "$session_dir"
    else
      # Create session in current directory with the given name
      tmux new-session -d -s "$session_name" -c "$current_dir" "bash -l"
      # Attach to the newly created session
      exec tmux attach-session -t "$session_name"
    fi
  fi
fi