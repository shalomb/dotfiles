#!/usr/bin/env bun
/** pi-find: search all pi sessions; on a terminal pick one with fzf and resume it in its worktree and profile. */
import { readSync } from "node:fs";
import { runPicker, spawnFzf, hasFzf, gitCreateWorktree, spawnResume, shellCwdProfile } from "../../.pi/agent/extensions/_lib/registry-pick";

/** Line prompt on the terminal; empty answer keeps the suggestion, EOF cancels. */
function prompt(question: string, suggestion: string): string | null {
	process.stderr.write(`${question} [${suggestion}]: `);
	const buf = Buffer.alloc(1);
	let line = "";
	while (readSync(0, buf, 0, 1, null) === 1) {
		if (buf[0] === 10) return line.trim() || suggestion;
		line += buf.toString();
	}
	return null;
}

const result = runPicker(process.argv.slice(2), process.cwd(), {
	isTTY: Boolean(process.stdout.isTTY && process.stdin.isTTY),
	fzfAvailable: hasFzf(),
	io: { write: (s: string) => process.stdout.write(s), error: (s: string) => process.stderr.write(s) },
	run: spawnFzf,
	prompt,
	createWorktree: gitCreateWorktree,
	warn: (m: string) => process.stderr.write(m + "\n"),
	cwdProfile: (cwd: string) => shellCwdProfile(cwd),
	launch: spawnResume,
});

if (result.output !== undefined) console.log(result.output);
process.exit(result.exitCode);
