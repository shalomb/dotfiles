#!/usr/bin/env python3

# claude-sessions
#
# List previous Claude Code sessions for a given working directory,
# sorted by reverse chronological order.

import json
import os
import sys
from pathlib import Path
from datetime import datetime, timezone


def usage():
    print(f"Usage: {os.path.basename(sys.argv[0])} [<working-dir>]")
    print()
    print("List Claude Code sessions for the given directory (default: cwd).")


def dir_to_project_key(path: Path) -> str:
    return str(path.resolve()).replace("/", "-")


def parse_session(jsonl_path: Path) -> dict | None:
    session_id = jsonl_path.stem
    stat = jsonl_path.stat()
    size = stat.st_size
    mtime = datetime.fromtimestamp(stat.st_mtime, tz=timezone.utc)

    first_ts = None
    last_ts = None
    first_msg = None
    line_count = 0
    cwd = None

    try:
        with open(jsonl_path) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                line_count += 1
                try:
                    record = json.loads(line)
                except json.JSONDecodeError:
                    continue

                ts_str = record.get("timestamp")
                if ts_str:
                    try:
                        ts = datetime.fromisoformat(ts_str.replace("Z", "+00:00"))
                        if first_ts is None:
                            first_ts = ts
                        last_ts = ts
                    except ValueError:
                        pass

                if cwd is None:
                    cwd = record.get("cwd")

                if first_msg is None and record.get("type") == "user":
                    msg = record.get("message", {})
                    content = msg.get("content", "")
                    if isinstance(content, str) and content.strip():
                        first_msg = content.strip()
                    elif isinstance(content, list):
                        for part in content:
                            if isinstance(part, dict) and part.get("type") == "text":
                                text = part.get("text", "").strip()
                                if text:
                                    first_msg = text
                                    break
    except OSError:
        return None

    return {
        "session_id": session_id,
        "path": jsonl_path,
        "size": size,
        "lines": line_count,
        "first_ts": first_ts,
        "last_ts": last_ts,
        "mtime": mtime,
        "first_msg": first_msg,
        "cwd": cwd,
    }


def human_size(n: int) -> str:
    for unit in ("B", "K", "M", "G"):
        if n < 1024:
            return f"{n:.0f}{unit}"
        n /= 1024
    return f"{n:.1f}T"


def format_ts(ts: datetime | None) -> str:
    if ts is None:
        return "unknown"
    return ts.astimezone().strftime("%Y-%m-%d %H:%M:%S")


def truncate(s: str, width: int) -> str:
    if s and len(s) > width:
        return s[: width - 1] + "…"
    return s or ""


def main():
    args = sys.argv[1:]

    if args and args[0] in ("-h", "--help"):
        usage()
        sys.exit(0)

    target_dir = Path(args[0]) if args else Path.cwd()
    if not target_dir.is_dir():
        print(f"error: not a directory: {target_dir}", file=sys.stderr)
        sys.exit(1)

    project_key = dir_to_project_key(target_dir)
    projects_dir = Path.home() / ".claude" / "projects"
    session_dir = projects_dir / project_key

    if not session_dir.exists():
        print(f"No Claude sessions found for: {target_dir.resolve()}")
        sys.exit(0)

    jsonl_files = sorted(session_dir.glob("*.jsonl"), key=lambda p: p.stat().st_mtime, reverse=True)

    if not jsonl_files:
        print(f"No Claude sessions found for: {target_dir.resolve()}")
        sys.exit(0)

    sessions = [s for f in jsonl_files if (s := parse_session(f)) is not None]
    sessions.sort(key=lambda s: s["last_ts"] or s["mtime"], reverse=True)

    print(f"Claude sessions for: {target_dir.resolve()}")
    print(f"Session dir: {session_dir}")
    print()

    col_id    = 36
    col_start = 19
    col_end   = 19
    col_size  = 6
    col_lines = 6
    col_msg   = 60

    header = (
        f"{'SESSION ID':<{col_id}}  "
        f"{'STARTED':<{col_start}}  "
        f"{'LAST ACTIVE':<{col_end}}  "
        f"{'SIZE':>{col_size}}  "
        f"{'LINES':>{col_lines}}  "
        f"{'FIRST MESSAGE':<{col_msg}}"
    )
    print(header)
    print("-" * len(header))

    for s in sessions:
        msg_preview = truncate(s["first_msg"] or "", col_msg)
        print(
            f"{s['session_id']:<{col_id}}  "
            f"{format_ts(s['first_ts']):<{col_start}}  "
            f"{format_ts(s['last_ts']):<{col_end}}  "
            f"{human_size(s['size']):>{col_size}}  "
            f"{s['lines']:>{col_lines}}  "
            f"{msg_preview:<{col_msg}}"
        )


if __name__ == "__main__":
    main()

