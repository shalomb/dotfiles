#!/usr/bin/env bash
# Fast evaluation of @pi_attn across all tmux panes for tmux status-right
# Formats with palette #ff6633 warm orange and unicode glyph ●
raw=$(tmux list-panes -a -F '#{session_name}|#{window_index}|#{pane_index}|#{@pi_attn}' 2>/dev/null)
[ -z "$raw" ] && exit 0

count=0
first_loc=""

while IFS='|' read -r session window pane attn; do
    [ -z "$attn" ] && continue
    count=$((count + 1))
    if [ -z "$first_loc" ]; then
        first_loc="${session}:${window}.${pane}"
    fi
done <<< "$raw"

if [ "$count" -eq 1 ]; then
    printf "#[fg=#ff6633]● %s#[default] " "$first_loc"
elif [ "$count" -gt 1 ]; then
    printf "#[fg=#ff6633]● [%d] %s#[default] " "$count" "$first_loc"
fi
