#!/bin/bash

# ob-cli wrapper for ob/tips commands
# This script provides compatibility with the original bash implementation

# Determine mode based on command name
mode="auto"
if [[ ${0##*/} == "tips" ]]; then
    mode="tips"
elif [[ ${0##*/} == "ob" ]]; then
    mode="obsidian"
fi

# Run ob-cli with the determined mode
exec ob-cli --mode="$mode" "$@"