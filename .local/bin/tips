#!/bin/bash

# NAME
#   tips - invoke tip files on demand

# SYNOPSIS
#   tips [word|word..]]
#   tips / shell_command args

# DESCRIPTION

set -o errexit -o nounset -o pipefail
shopt -s extglob nullglob globstar

[[ -n ${DEBUG-} && ${DEBUG-} != 0 ]] && set -xv

mode='tips'
if [[ ${0##*/} == @(obsidian|ob) ]]; then
  mode='obsidian'
fi

if [[ -e ~/.config/$mode/config ]]; then
  source ~/.config/$mode/config
fi

tipsdir="${tipsdir:-~/$mode}"

if [[ ! -d "$tipsdir" ]]; then
  echo "No such directory '$tipsdir', $?"
  exit 2
fi

function list_tips() {
  local pattern="${1:-.}"
  find ./* \( -name ".[!.]?*" \) \
    -prune -o -iregex ".*$pattern.*" -print0 | sort -z
}

oldpwd="$PWD"
cd "$tipsdir" || exit

if (( $# > 0 )) && [[ $1 = @(-l|--ls|--list) ]]; then
  list_tips | perl -lpe 'BEGIN{$/="\0"}' | column | less
  exit $?

elif (( $# > 0 )) && [[ $1 = @(-s|--st|--status) ]]; then
  git status --short --porcelain
  exit $?

elif (( $# > 0 )) && [[ $1 = @(--sync) ]]; then
  # Simple: stash, pull rebase, pop stash
  git stash
  git pull --rebase
  git stash pop
  exit $?

elif (( $# > 0 )) && [[ $1 = "/" ]]; then
  shift;
  cmd="$1"; shift;
  ( set -x; "$cmd" "$@"; ) 2>&1 | less
  exit $?;

fi

# If no arguments, use fzf for interactive selection like cdp
if (( $# == 0 )); then
  # Check for changes on origin
  if git fetch --all --quiet; then
    behind=$(git rev-list --count HEAD..@{upstream} 2>/dev/null || echo "0")
    ahead=$(git rev-list --count @{upstream}..HEAD 2>/dev/null || echo "0")
    
    if [[ $behind -gt 0 ]]; then
      echo "⚠️  Repository is $behind commits behind origin"
      echo "   Run 'ob --sync' to update"
      echo ""
    fi
    
    if [[ $ahead -gt 0 ]]; then
      echo "📤 Repository is $ahead commits ahead of origin"
      echo ""
    fi
  fi
  
  query=""
  
  # Get list of existing files and directories
  selection="$( {
    # List existing files and directories
    find . -type f -print0 | sort -z | perl -lpe 'BEGIN{$/="\0"}'
    find . -type d -print0 | sort -z | perl -lpe 'BEGIN{$/="\0"}'
  } | fzf --ansi \
          --bind=ctrl-s:toggle-sort \
          --cycle \
          --height 60% \
          --no-mouse \
          --print-query \
          --query="$query" \
          --reverse \
          --tiebreak=index \
          --header="Select file to edit (or type new filename)"
  )"

  query="${selection%$'\n'}"
  selection="${selection##*$'\n'}"

  # Debug output
  echo "DEBUG: Raw fzf output: '$selection'"
  echo "DEBUG: Query: '$query'"
  echo "DEBUG: Selection: '$selection'"

  [[ -z $selection && -z $query ]] && exit 0

  # Use selection if available, otherwise use query for new file
  target="${selection:-$query}"
  echo "DEBUG: Initial target: '$target'"
  
  # Clean up the target path
  target="${target//\/\///}"
  target="${target//\*/}"
  echo "DEBUG: After cleanup: '$target'"
  
  # Handle tips files - convert tips/ prefix to actual path
  if [[ $target == tips/* ]]; then
    echo "DEBUG: Detected tips file"
    actual_target="$HOME/tips/${target#tips/}"
    echo "DEBUG: Actual tips target: '$actual_target'"
    if [[ -e "$actual_target" ]]; then
      target="$actual_target"
      echo "DEBUG: Tips file exists, using: '$target'"
    else
      # For new tips files, create in tips directory
      dir="$HOME/tips/${target#tips/}"
      dir="${dir%/*}"
      echo "DEBUG: Creating tips directory: '$dir'"
      if [[ $dir != "$target" ]] && [[ ! -d $dir ]]; then
        mkdir -vp "$dir"
      fi
      target="$HOME/tips/${target#tips/}"
      echo "Creating new tips file: $target"
    fi
  else
    echo "DEBUG: Regular file (not tips)"
    # Handle directory creation for new files in current directory
    if [[ ! -e "$target" ]]; then
      echo "DEBUG: File doesn't exist, creating directory structure"
      dir="${target%/*}"
      echo "DEBUG: Directory for new file: '$dir'"
      if [[ $dir != "$target" ]] && [[ ! -d $dir ]]; then
        mkdir -vp "$dir"
        echo "DEBUG: Created directory: '$dir'"
      fi
      echo "Creating new file: $target"
    else
      echo "DEBUG: File exists: '$target'"
    fi
  fi
  
  echo "DEBUG: Final target for nvim: '$target'"
  nvim -c 'set conceallevel=2' "$target"
  exit $?
fi

# Handle explicit arguments (existing behavior)
files=()
for glob in "$@"; do
  while read -r -d $'' file; do
    files+=( "$file" )
  done < <( list_tips "$glob" )
done

if (( ${#files[@]} == 0 )); then
  files=( "$@" )
fi

files=( "${files[@]//\/\///}" )
files=( "${files[@]//\*/}"    )

for f in "${files[@]}"; do
  dir="${f%%/*}";
  if [[ $dir != "$f" ]] && [[ ! -d $dir ]]; then
    mkdir -vp "$dir"
  fi
done

nvim -c 'set conceallevel=2' "${files[0]:-.}"
