#!/usr/bin/env bash
# AGENT_CONTEXT: C-a C-p jumps to a tmux pane whose pi agent set @pi_attn
# DESIGN_PATTERN: same urgency as pi-attn-status (stopped/other > rest stop > arrived);
#   one pane: jump straight there; several: fzf picker, most urgent first
set -eo pipefail

raw=$(tmux list-panes -a -F '#{session_name}|#{window_index}|#{pane_index}|#{@pi_attn}' 2>/dev/null) || true

rows=$(while IFS='|' read -r session window pane attn; do
    [ -z "$attn" ] && continue
    case "$attn" in
        "arrived"*) rank=1 ;;
        "rest stop"*) rank=2 ;;
        *) rank=3 ;;
    esac
    printf '%s\t%-16s  %s\n' "$rank" "${session}:${window}.${pane}" "$attn"
done <<< "$raw" | sort -t$'\t' -k1,1nr -s | cut -f2-)

if [ -z "$rows" ]; then
    tmux display-message "No pi agents need attention"
    exit 0
fi

if [ "$(wc -l <<< "$rows")" -eq 1 ]; then
    picked=$rows
else
    picked=$(fzf --reverse --header="Pi panes needing attention (most urgent first)" <<< "$rows") || exit 0
fi

target=${picked%% *}
sess=${target%%:*}
win=${target%.*}
tmux switch-client -t "$sess" \; select-window -t "$win" \; select-pane -t "$target"
